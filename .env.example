# ---- LINE Messaging API（LINE Developers Console → 你的 Messaging API channel）----
# Basic settings → Channel secret
LINE_CHANNEL_SECRET=
# Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# ---- 伺服器 ----
PORT=3000
# SQLite 資料庫路徑
DB_PATH=./data/linehub.db
# 圖片/影片/音訊/檔案下載位置
MEDIA_DIR=./data/media
# 是否自動下載多媒體訊息內容（LINE 只保留一段時間，建議開啟）
DOWNLOAD_MEDIA=true
# 管理後台與 /api 的 Bearer Token（留空 = 不驗證，僅限本機測試）
ADMIN_TOKEN=

# ---- 後續應用（processors）----
# 關鍵字警示：逗號分隔，命中時記錄於 alerts 並推送到 FORWARD_WEBHOOK_URL
ALERT_KEYWORDS=報價,客訴,緊急
# 將每則訊息（標準化後的 JSON）轉發至外部系統，例如 n8n / Zapier / 自家 API
FORWARD_WEBHOOK_URL=
# 群組內輸入 "/hub" 時由 Bot 回覆狀態（展示 reply API），false 則 Bot 完全靜默
ENABLE_BOT_COMMANDS=false

# ---- AI 每日群組摘要（Claude API）----
# https://platform.claude.com/ 取得 API key；未設定則停用摘要功能
ANTHROPIC_API_KEY=
# 每天這個時間（SUMMARY_TZ 當地時間）為「前一天」的群組對話產生摘要
SUMMARY_TIME=08:00
SUMMARY_TZ=Asia/Taipei
# 當天訊息數少於此值的群組不做摘要
SUMMARY_MIN_MESSAGES=5
SUMMARY_MODEL=claude-opus-5-5
# low / medium / high：越高越仔細、花費越多
SUMMARY_EFFORT=medium
# 是否用 push API 把摘要發回群組（會消耗官方帳號每月訊息額度）
SUMMARY_PUSH_TO_GROUP=false
